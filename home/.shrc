#
# .shrc - bourne shell startup file 
#
# This file will be used if the shell is invoked for interactive use and
# the environment variable ENV is set to this file.
#
# see also sh(1), environ(7).
#

# file permissions: rwxr-xr-x
#
# umask	022

set -o vi

# be paranoid
alias cp='cp -ip'
alias mv='mv -i'
alias rm='rm -i'

alias history='fc -l'

get_ps1() {
  # sed required to use bar delimiter
  path=$(printf $PWD | sed "s|${HOME}|~|g")
  p=${path#${path%/*/*}/}
  j=$(($(jobs -p | wc -l) - 1))
  x=$(if [ $j -ne 0 ]; then printf "[$j]"; else printf ""; fi)
  printf '%s@%s:%s [%s]$ ' "${USER}" "$HOSTNAME" "$p" "$x"
}

PS1='$(get_ps1)'


# search path for cd(1)
CDPATH=:$HOME

alias tree='tree -F --dirsfirst -a -I .git'
alias ls='ls -lFG'

# ------------------------

# vim: set et sw=2 sts=2 tw=78 ft=sh:
